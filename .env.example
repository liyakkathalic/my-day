# Copy to .env and fill in. Never commit .env.

# Where the database, VAPID keys and daily backups are stored.
DATA_DIR=./data

# Port the Node server listens on (Caddy forwards HTTPS traffic to it).
PORT=8080
HOST=127.0.0.1

# Set to 1 when running behind Caddy / a reverse proxy (enables HSTS and real client IPs).
TRUST_PROXY=0

# Contact for the push services. Apple rejects pushes without a real one.
VAPID_SUBJECT=mailto:you@example.com

# Optional: fixed VAPID keys (npm run gen-vapid). If empty, keys are generated
# once and stored in DATA_DIR/vapid.json — back that file up with the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Number of daily server-side database copies to keep.
BACKUP_KEEP_DAYS=14

# Only for local development over http://localhost (cookies without the Secure flag).
INSECURE_COOKIES=0
